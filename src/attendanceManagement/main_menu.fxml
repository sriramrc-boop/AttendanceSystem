<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="attendanceManagement.MainMenuController" style="-fx-background-color: #f4f4f4; -fx-padding: 40;">
    <Label text="Attendance Management System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    
    <Label text="Please select your role to continue:" style="-fx-font-size: 14px;"/>
    
    <HBox spacing="30" alignment="CENTER">
        <Button text="Instructor Portal" onAction="#btnClickedInstructor" prefWidth="150" prefHeight="50" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        
        <Button text="Student Portal" onAction="#btnClickedStudent" prefWidth="150" prefHeight="50" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
    
    <Label text="Version 1.0" style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
</VBox>